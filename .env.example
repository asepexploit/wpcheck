# Copy file ini jadi `.env` (di folder yang sama) lalu isi/sesuaikan nilainya.

# Kredensial bucket API files.php (untuk --remote / auto-detect txt), BUKAN
# kredensial WordPress target.
REMOTE_FILES_BASE_URL=
REMOTE_FILES_API_KEY=

# ---------- Speed / concurrency ----------
# Opsional -- override default hardcoded. CLI --workers/--timeout/--delay
# tetap prioritas tertinggi kalau dipass.
WORKERS=
TIMEOUT=
DELAY=

# ---------- Telegram notifications ----------
# Opsional -- override default bot. Setiap site yang login VALID dikirim ke
# bot ini. Kosongkan untuk pakai default, atau override lewat CLI
# --telegram-token/--telegram-chat-id.
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# ---------- License-check ----------
# CATATAN: wp-check ini reuse LICENSE_DEVICE_TOKEN yang sama dengan searchhost
# utama (telegram_login) dan checker/ WHMCS -- kalau dijalankan di PC yang sama
# dan .env root searchhost sudah terisi, bagian ini TIDAK WAJIB diisi ulang
# (wp-check otomatis membaca ../../.env). Isi kalau mau override lokal /
# dijalankan berdiri sendiri.
LICENSE_CHECK_URL=
LICENSE_DEVICE_TOKEN=
LICENSE_CHECK_TIMEOUT_SECONDS=5
